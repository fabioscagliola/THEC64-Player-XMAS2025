2200   IF O$ = "3" THEN F = F / 2 : GOTO 2230
2210   IF O$ = "5" THEN F = F * 2 : GOTO 2230
2220   IF O$ = "6" THEN F = F * 4 : GOTO 2230
2230   F(I) = F
2240   FH = F(I) / 256
2250   FL = F(I) - 256 * FH
2260   POKE S + 7 * I, FL
2270   POKE S + 7 * I + 1, FH
2280   POKE S + 7 * I + 4, W + 1
